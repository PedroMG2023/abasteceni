    usecase "CU-11\nReservar volumen" as CU11
    usecase "CU-10\nPublicar excedente agrícola" as CU10
  }
  rectangle "Identidad y acceso · M1 · M2 · PM-01" {
    usecase "CU-05\nRecuperar credencial" as CU05
    usecase "CU-01\nRegistrar cuenta comercial" as CU01
    usecase "CU-26\nOtorgar consentimiento" as CU26
