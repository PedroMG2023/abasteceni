@startuml MD-06-objetos-escenario-a
' MD-06 — Modelo de objetos (D5 §2.12.6)
' Pregunta: ¿satisface una configuración concreta y realista las
' multiplicidades e invariantes que declara el modelo de clases?
' Punto de vista rector: PV-01 en su función de verificación. Diez objetos.
' Instancia: escenario A del concepto operacional de D2 §2.6. Tres farmacias del
' departamento de Chinandega (D5 §2.1.4); la figura de D5 v1.1 mostraba una
' ferretería y una pulpería (INC-16).
' Trazabilidad: verifica MD-01; SYS-FN-09, 11, 18 y 20. Iteración: IT-03, IT-06.
' Verificación (AM-03): 100 + 60 + 100 = 260 cajas; rondas = 1 <= 3.

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam object {
  BackgroundColor #F4F4F4
  BorderColor #555555
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #999999
}

object "distribuidoraManagua : Proveedor" as prov {
  razonSocial = "Distribuidora Centro, S.A."
  estado = Activa
}
object "cot1 : Cotizacion" as cot1 {
  precioUnitario = C$ 178,00 / caja
  plazoEntregaDias = 5
  vigencia = 2026-10-05
  rondas = 1
  estado = ContraOfertada
}
object "co1 : ContraOferta" as co1 {
  precioPropuesto = C$ 168,00 / caja
  volumen = 260 cajas
}
object "farmaciaElViejo : Comprador" as f1 {
  razonSocial = "Farmacia San José"
  ubicacion = (Chinandega, El Viejo)
  estado = Activa
}
object "farmaciaChinandega : Comprador" as f2 {
  razonSocial = "Farmacia Santa Ana"
  ubicacion = (Chinandega, Chinandega)
  estado = Activa
}
object "farmaciaElViejoNorte : Comprador" as f3 {
  razonSocial = "Farmacia El Carmen"
  ubicacion = (Chinandega, El Viejo)
  estado = Activa
}
object "bloqueChinandega : BloqueDemanda" as bloque {
  categoria = Analgésicos genéricos
  departamento = "Chinandega"
  volumenAgregado = 260 cajas
  estado = Publicado
  expiraEn = 2026-10-15
}
object "d1 : Demanda" as d1 {
  categoria = Analgésicos genéricos
  volumen = 100 cajas
}
object "d2 : Demanda" as d2 {
  categoria = Analgésicos genéricos
  volumen = 60 cajas
}
object "d3 : Demanda" as d3 {
  categoria = Analgésicos genéricos
  volumen = 100 cajas
}

prov --> cot1 : emite
cot1 --> bloque : responde a
cot1 *-- co1
f1 --> d1 : publica
f2 --> d2 : publica
f3 --> d3 : publica
bloque o-- d1
bloque o-- d2
bloque o-- d3

note bottom of bloque
  Instantánea del escenario A del concepto operacional
  del documento 2. Verifica la multiplicidad 1..* entre
  BloqueDemanda y Demanda de MD-01, y la invariante
  rondas <= 3: aquí rondas = 1, quedan dos disponibles.
end note
@enduml
