# Copie este archivo como .env y asigne valores propios. Nunca versione .env
# (CLAUDE.md §9; control 8.9 de ISO/IEC 27002:2022).

# Base de datos local (docker-compose.yml)
CLAVE_SUPERUSUARIO_BD=
CLAVE_PROPIETARIO_BD=
CLAVE_APP_BD=

# Servicio de aplicación y trabajador. La aplicación se conecta con
# abasteceni_app; las migraciones, con abasteceni_propietario (ADR-05).
URL_BD_APP=postgresql://abasteceni_app:<clave>@localhost:5432/abasteceni
URL_BD_PROPIETARIO=postgresql://abasteceni_propietario:<clave>@localhost:5432/abasteceni
PUERTO_API=3000
SECRETO_FIRMA_ACCESO=
ORIGEN_WEB=http://localhost:5173
COOKIE_SEGURA=true
PROXIES_CONFIABLES=0

# Siembra del Administrador de la plataforma (DIS-24)
CORREO_ADMINISTRADOR=
CONTRASENA_ADMINISTRADOR=

# Trabajador: el proveedor de WhatsApp es simulado en IT-01 (disponible | caido)
SIMULACION_WHATSAPP=disponible
CANAL_NOTIFICACION=whatsapp
